{
  "name": "brilliancy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:static": "node scripts/verify-static-hero.mjs",
    "verify:static:dist": "npm run build && node scripts/verify-static-hero.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:lichess": "node scripts/verify-lichess.mjs",
    "verify:single": "node scripts/verify-single-game.mjs",
    "verify:scope": "node scripts/verify-scope-cap.mjs",
    "verify:announce": "node scripts/verify-scan-announcement.mjs",
    "verify:csp": "npm run build && node scripts/csp-check.mjs",
    "verify": "npm run verify:static && npm run verify:contrast && npm run verify:announce && npm run verify:scope && npm run verify:single && npm run verify:lichess"
  },
  "dependencies": {
    "chess.js": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
