node_modules
dist
dist-ssr
*.local
.DS_Store
.vite

# Screenshot output from scripts/shots.mjs — regenerate, don't version.
scripts/shot-*.png

# Local Obsidian UI state that happens to sit in this folder. It's window
# layouts and machine paths, not project config.
.obsidian

# Per-machine Claude Code permissions. .claude/launch.json IS committed — it's
# how anyone else gets `npm run dev` wired to the preview tooling.
.claude/settings.local.json

# NOTE: public/engine/ is deliberately NOT ignored. The 40 MB Stockfish network
# is a build input, it never changes, and its filename is its own SHA-256 prefix
# so it's verifiable. This is why the repo is large.

# Local Netlify folder
.netlify

# Harvested chess.com data for OTHER people's accounts.
#
# The scripts are committed; the data they pull is not. Everything here comes
# from public pages and the public API, but this repo is public, and compiling
# other members' usernames and game history into someone else's git history
# forever is a different act from reading a page that is already public. Anyone
# who wants the data can regenerate it:
#
#   node scripts/find-accounts.mjs --club <club> --min 800 --max 1600
#   node scripts/brilliant-list.mjs <user>…
#   node scripts/harvest-multi.mjs <user>…
#
# louismcdade's own labels and dataset ARE committed — they are the fixtures the
# harness scores against, and they are his to publish.
scripts/brilliant-lists/
scripts/harvest-multi.json
scripts/dataset-multi.csv

# Cached chess.com monthly archives (immutable months only; regenerable)
scripts/.cache/
